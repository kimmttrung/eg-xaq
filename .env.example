# Copy file này thành `.env` rồi điền giá trị thật. `.env` đã nằm trong .gitignore.

# ---------- LLM Narrator ----------
# Chỉ dùng để DIỄN ĐẠT bằng chứng, không phải nguồn tri thức.
ANTHROPIC_API_KEY=
EGXAQ_LLM_MODEL=claude-opus-5
# dryrun = render bằng template Python, không gọi API (mặc định khi dev/test)
# anthropic = gọi Claude API
EGXAQ_NARRATOR_BACKEND=dryrun

# ---------- Vector DB (Qdrant) ----------
EGXAQ_QDRANT_URL=http://localhost:6333
EGXAQ_QDRANT_API_KEY=
EGXAQ_QDRANT_COLLECTION=egxaq_papers

# ---------- Embedding / Rerank ----------
# hash    = embedding giả lập, offline, chỉ để chạy test (KHÔNG dùng cho kết quả khóa luận)
# hf      = sentence-transformers, tải model thật từ HuggingFace
EGXAQ_EMBEDDING_BACKEND=hash
EGXAQ_EMBEDDING_MODEL=BAAI/bge-m3
EGXAQ_EMBEDDING_DIM=1024
EGXAQ_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EGXAQ_USE_RERANKER=false

# ---------- Corpus builder ----------
# OpenAlex chỉ cần email (polite pool), không cần API key.
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# ---------- Nguồn dữ liệu ----------
# mock = dữ liệu tổng hợp có kiểm soát (dùng khi chưa có data lab)
# lab  = đọc raster GFS + checkpoint XGBoost của lab
EGXAQ_DATA_BACKEND=mock
EGXAQ_XAI_BACKEND=mock
EGXAQ_LAB_MODEL_DIR=
EGXAQ_LAB_RASTER_DIR=

# ---------- FIRMS (điểm cháy) ----------
FIRMS_MAP_KEY=
